%%{init: {"theme": "default", "themeVariables": {"primaryTextColor": "#334155", "lineColor": "#94a3b8", "fontSize": "14px"}}}%%
flowchart TB
    classDef extracted fill:#22c55e,stroke:#16a34a,color:#ffffff
    classDef modeled   fill:#f59e0b,stroke:#d97706,color:#ffffff
    classDef assumed   fill:#ef4444,stroke:#dc2626,color:#ffffff
    classDef absent    fill:#94a3b8,stroke:#64748b,color:#ffffff

    subgraph SRC["1 · program image"]
        direction TB
        ELF["ELF bytes"]:::absent
        RAW["raw 32-bit word"]:::modeled
        DEC["DecodedRv64im"]:::extracted
        ZI["ZiskInst row"]:::extracted
        ELF -->|"riscv_interpreter"| RAW
        RAW -->|"decode_32_core"| DEC
        DEC -->|"lower_rv64im_<br/>single_row"| ZI
    end

    subgraph ROMB["2 · ROM build"]
        direction LR
        MAP["ZiskRom BTreeMap"]:::absent
        AEN["Rv64imTranspile<br/>RowsExtract"]:::extracted
        ROMT["ROM table<br/>trace.program"]:::modeled
        MAP -->|"RomSM::<br/>compute_trace_rom"| ROMT
        AEN -->|"ProgramRows<br/>Binding"| ROMT
    end

    subgraph WIT["3 · witness"]
        direction LR
        EMU["EmuTrace"]:::absent
        MT["Main AIR row"]:::modeled
        OB["op-bus tuple"]:::modeled
        SEC["Binary / Arith rows"]:::modeled
        EMU -->|"Emu::build_<br/>full_trace_step"| MT
        MT -->|"opBus_row_Main"| OB
        OB -->|"channels_balanced"| SEC
    end

    subgraph CON["4 · constraints"]
        direction LR
        PIL["*.pil"]:::absent
        PO["zisk.pilout"]:::absent
        EX["Extraction/*.lean"]:::extracted
        VA["Valid_&lt;AIR&gt;"]:::modeled
        PIL -->|"pil2-compiler"| PO
        PO -->|"pil-extract air"| EX
        EX -->|"*MirrorWeld"| VA
    end

    ZI   -->|"insert_inst"| MAP
    ZI   -->|"extract_transpile_<br/>rv64im_rows_raw"| AEN
    MAP  -->|"Emu::step_fast"| EMU
    ROMT -->|"mainWithRom"| MT
    VA   -->|"Bridge.rowAt"| MT

    linkStyle 0  stroke:#94a3b8,stroke-width:2px
    linkStyle 1  stroke:#22c55e,stroke-width:3px
    linkStyle 2  stroke:#22c55e,stroke-width:3px
    linkStyle 3  stroke:#94a3b8,stroke-width:2px
    linkStyle 4  stroke:#ef4444,stroke-width:3px
    linkStyle 5  stroke:#94a3b8,stroke-width:2px
    linkStyle 6  stroke:#f59e0b,stroke-width:3px
    linkStyle 7  stroke:#ef4444,stroke-width:3px
    linkStyle 8  stroke:#94a3b8,stroke-width:2px
    linkStyle 9  stroke:#22c55e,stroke-width:3px
    linkStyle 10 stroke:#f59e0b,stroke-width:3px
    linkStyle 11 stroke:#94a3b8,stroke-width:2px
    linkStyle 12 stroke:#22c55e,stroke-width:3px
    linkStyle 13 stroke:#94a3b8,stroke-width:2px
    linkStyle 14 stroke:#f59e0b,stroke-width:3px
    linkStyle 15 stroke:#f59e0b,stroke-width:3px

    style SRC  fill:#f8fafc,stroke:#cbd5e1
    style ROMB fill:#f8fafc,stroke:#cbd5e1
    style WIT  fill:#f8fafc,stroke:#cbd5e1
    style CON  fill:#f8fafc,stroke:#cbd5e1
