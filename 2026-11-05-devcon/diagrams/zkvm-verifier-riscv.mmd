%%{init: {"theme": "default", "flowchart": {"wrappingWidth": 330}, "themeVariables": {"primaryColor": "#eef1f6", "primaryTextColor": "#334155", "lineColor": "#0c9fde", "secondaryColor": "#f5f7fa", "fontSize": "20px"}}}%%
flowchart LR
    classDef io fill:#eef1f6,stroke:#0c9fde,color:#334155,stroke-width:3px
    classDef proc fill:#0c9fde,stroke:#0a7bb8,color:#ffffff,stroke-width:3px
    classDef proof fill:#22c55e,stroke:#16a34a,color:#ffffff,stroke-width:3px
    classDef result fill:#eef1f6,stroke:#64748b,color:#334155,stroke-width:3px

    subgraph Attester["Attester Node"]
            direction LR
            Inputs["pre-state root, post-state root, block hash, EVM implementation"]:::io --> ZKV
            Proof:::proof --> ZKV[zkVM Verifier]:::proc
            ZKV --> Result["True / False"]:::result
    end

    style Attester fill:none,stroke:#64748b,color:#334155,stroke-width:3px
    linkStyle default stroke-width:3px
