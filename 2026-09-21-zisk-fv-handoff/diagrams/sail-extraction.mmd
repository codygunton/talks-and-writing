    EXTRAS["RiscvExtras.lean<br/>75 axioms"]:::assumed
    GEN["LeanRV64D<br/>144 generated files · 144,023 lines"]:::extracted
    EXECR["LeanRV64D.Functions.execute<br/>instruction → SailM Result"]:::extracted
    EXECI["execute_instruction<br/>fetch, then execute"]:::modeled
    PURE["PureSpec.execute_&lt;OP&gt;_pure<br/>63 · no state monad"]:::modeled
    RVA["RISC_V_assumptions<br/>platform profile"]:::assumed
    BE["bus_effect<br/>bus rows → state update"]:::modeled
    ZISK["ZisK side<br/>exec-bus + mem-bus rows"]:::modeled

    SAIL   -->|"sail --lean --all-modules<br/>(sail 0.20.1)"| GEN
